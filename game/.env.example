# Schoonmaker — copy to game/.env (or MeWorld/.env for legacy layout)

# Case chat (#126 panel) — server picks DeepSeek if set, else OpenAI
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Real World tab — stories + YouTube video match
#
# FREE STACK (no Gemini / no Google billing):
#   DEEPSEEK_API_KEY=sk-...     — patient stories (default provider; very cheap)
#   REAL_WORLD_PROVIDER=deepseek
#   REAL_WORLD_VIDEO_PROVIDER=yt-search   — free YouTube search (npm yt-search, no key)
#   Leave GEMINI_API_KEY empty — avoids quota errors and slow Gemini retries
#
# PAID / OPTIONAL Gemini (Google AI Studio billing or Vertex):
#   REAL_WORLD_PROVIDER=gemini
#   GEMINI_API_KEY=              — Google Search grounding for stories + video repair
#   GEMINI_REALWORLD_MODEL=gemini-2.5-flash
#   REAL_WORLD_VIDEO_PROVIDER=auto — try Gemini first, then yt-search fallback
#
# REAL_WORLD_PROVIDER=deepseek  (default when DEEPSEEK_API_KEY set)
# REAL_WORLD_VIDEO_PROVIDER=yt-search | auto

# Optional chat models (defaults: deepseek-chat / gpt-4o-mini)
# DEEPSEEK_CHAT_MODEL=deepseek-chat
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Voice input — Cursor-style batch STT (record full clip, transcribe on stop)
# WHISPER_MODE=auto          # auto | local | openai
# WHISPER_MODEL=small.en       # tiny.en | base.en | small.en | medium.en
# WHISPER_PYTHON=python        # path to Python with faster-whisper installed

# fal.ai — https://fal.ai/dashboard/keys (optional scene generation)
FAL_KEY=

# Optional: fal | openai | auto
# SCENE_IMAGE_PROVIDER=auto
# FAL_SCENE_MODEL=fal-ai/joyai-image-edit

# API port (default 3001)
# SPORTMAKER_API_PORT=3001

# Optional — Chatterbox Turbo Read aloud
# Use CHATTERBOX_VOICE_REF=none for Chatterbox's default/unprompted voice.
# Set CHATTERBOX_VOICE_REF to an audio file only when you want voice cloning.
# Install Chatterbox separately — do NOT copy the full ML repo into this project.
# CHATTERBOX_ROOT=C:\Users\steve\chatterbox
# CHATTERBOX_PYTHON=C:\Users\steve\chatterbox\.venv\Scripts\python.exe
# CHATTERBOX_VOICE_REF=none

# Optional — magic link email
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
