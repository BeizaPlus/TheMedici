# Cloud deploy (Render full-stack OR Vercel frontend + API host)
# Copy keys from your local MeWorld/.env — never commit real values.

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
YOUTUBE_API_KEY=

# Speech-to-text on cloud (no local Whisper/Chatterbox)
WHISPER_MODE=openai

# Render full-stack only — serves dist/ + API on one URL
SERVE_STATIC=1

# Vercel frontend + separate API host only — set at Vercel build time:
# VITE_API_BASE=https://your-api.onrender.com

# Split deploy CORS — comma-separated frontend origins
# CORS_ORIGIN=https://me-world.vercel.app,https://your-custom-domain.com
