+function renderTakes() {
+  const panel = g("takes-panel"), list = g("takes-list"), countEl = g("takes-count");
+  const takes = speechTakes[current] || [];
+  const hasTakes = takes.length > 0;
+  const minBtn = g("takes-min-btn");
+
+  // always sync visibility and minimized state from the current flags
+  panel.classList.toggle("visible", takesOpen);
+  panel.classList.toggle("minimized", takesMinimized);
+  if (minBtn) minBtn.textContent = takesMinimized ? "+" : "−";
+
+  syncTakesChip();
